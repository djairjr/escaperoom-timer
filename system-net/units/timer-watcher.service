[Unit]
Description=timer-watcher - applies the web configurator's sandbox requests (root)
After=network.target puzzle-configurator.service
Wants=puzzle-configurator.service

[Service]
Type=simple
ExecStart=/opt/puzzle-configurator/scripts/timer-watcher.sh
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
